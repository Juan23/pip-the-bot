#!/bin/zsh
# PreToolUse hook for workers (wired in by `worker` via worker-settings.json). Permission rules match command
# prefixes, so `git push origin pip/x:main` would pass a "pip/" rule; this checks the whole command instead.
# Allows exactly one kind of push, a worker's own branch; blocks other pushes, merges, and talking to Pip as Juan.
cmd=$(jq -r '.tool_input.command // empty')
[[ -z $cmd ]] && exit 0
decide() { jq -nc --arg d $1 --arg r "$2" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r}}'; exit 0 }

[[ $cmd =~ '^git push (-u |--set-upstream )?origin pip/[a-z0-9-]+$' ]] && decide allow "pushing the worker's own branch"
[[ $cmd == *git* && $cmd == *push* ]] && decide deny "Workers may only push their own branch, exactly: git push -u origin pip/<name>. Put anything else in your report for Pip."
[[ $cmd =~ 'gh +(pr +merge|api .*merge)' ]] && decide deny "Merging needs Juan's approval through Pip. Say so in your report."
[[ $cmd == *7377* || $cmd =~ '(^|[;&|(] *|/)(bot|notify)( |$)' ]] && decide deny "Workers can't message Pip or Juan directly. Put it in your report."
exit 0
